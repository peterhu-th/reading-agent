# Copy this file to .env for local development.
# Do not commit your real .env file.

OPENAI_API_KEY=replace-with-your-local-api-key
OPENAI_BASE_URL=http://127.0.0.1:3000/openai-codex-oauth/v1
CHAT_MODEL=gpt-5.4
ANSWER_MODEL=gpt-5.4
INTENT_MODEL=gpt-5.4
SUMMARY_MODEL=gpt-5.4
EVIDENCE_CHECK_MODEL=gpt-5.4
AUTO_START_API=true
AICLIENT2API_DIR=D:/gitstore/AIClient2API
API_START_TIMEOUT_SECONDS=30

VECTOR_DB_PATH=./data/index/chroma
RAW_EPUB_DIR=./data/raw/epub
BOOKS_JSONL_PATH=./data/processed/books_jsonl/books.jsonl
CHUNKS_JSONL_PATH=./data/processed/chunks_jsonl/chunks.jsonl
SUMMARIES_JSONL_PATH=./data/processed/summaries_jsonl/summaries.jsonl
CHROMA_COLLECTION=reading_memory_chunks
SUMMARY_CHROMA_COLLECTION=reading_memory_summaries
VECTOR_INITIAL_K=40
KEYWORD_INITIAL_K=40
RERANK_CANDIDATE_K=60
RERANK_TOP_K=15
FINAL_TOP_K=10
CONTEXT_MAX_CHARS=9000
CHUNK_SIZE=900
CHUNK_OVERLAP=180
SUMMARY_MAX_SOURCE_CHARS=3000
SUMMARY_CHAPTER_TARGET_CHARS=200
SUMMARY_BOOK_TARGET_CHARS=800
SUMMARY_BACKEND=extractive
SUMMARY_PROMPT_VERSION=summary_v2
CONVERSATION_MAX_TURNS=12
CONVERSATION_RECENT_TURNS=4
CONVERSATION_SUMMARY_INTERVAL=3
CONVERSATION_SUMMARY_MAX_CHARS=600
RETRIEVAL_MAX_SUPPLEMENT_ROUNDS=2
EVIDENCE_CHECK_MAX_CHARS=12000
EVIDENCE_MIN_CHUNKS=5
COMPARISON_MIN_CHUNKS_PER_BOOK=2
WEB_HOST=127.0.0.1
WEB_PORT=8000

EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=./models/bge-base-zh-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64
EMBEDDING_LOCAL_FILES_ONLY=true
RERANK_BACKEND=cross_encoder
RERANK_MODEL=./models/bge-reranker-base
RERANK_DEVICE=cuda
